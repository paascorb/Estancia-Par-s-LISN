import numpy as np
import pandas as pd

def calcular_precision(df):
    umbrales = np.arange(0.05, 1, 0.05)
    res = []
    for umb in umbrales:
        TP = 0
        Total = 0
        for index, row in df.iterrows():
            if round(row.Umbral, 2) == round(umb, 2):
                if row.Valor != 0:
                    TP += 1
                Total += 1
        res.append({"Umbral": round(umb, 2), "TP": TP, "Total": Total})
    return res

def calcular_recall(df):
    umbrales = np.arange(0.05, 1, 0.05)
    res = []
    for umb in umbrales:
        TP = 0
        Total = 0
        for index, row in df.iterrows():
            if round(row.Umbral, 2) == round(umb, 2):
                TP =+ len(row.Seleccionados)
                FN =+ len(row.Faltan)
        res.append({"Umbral": round(umb, 2), "TP": TP, "Total": TP+FN})
    return res

df = pd.read_csv("Datasets/gemma3_27B_propVal.csv")
df_recall = pd.read_csv("Datasets/gemma3_27B_propVal_recalls.csv")
prec = calcular_precision(df)
rec = calcular_recall(df_recall)
print("Precision")
for elem in prec:
    print(f'{elem["Umbral"]}: {round(elem["TP"]/elem["Total"], 4)}')
print("Recall")
for elem in rec:
    print(f'{elem["Umbral"]}: {round(elem["TP"]/elem["Total"], 4)}')